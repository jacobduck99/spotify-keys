#!/usr/bin/env bash
# Entry point for i3: bindsym ... exec --no-startup-id /path/to/spot <cmd>
# i3 may not have ~/.bun/bin on PATH, so fall back to the absolute path.
DIR="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
BUN="$(command -v bun || echo "$HOME/.bun/bin/bun")"
exec "$BUN" run "$DIR/src/cli.ts" "$@"
